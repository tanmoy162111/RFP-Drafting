{
  "name": "rfp-drafting",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:all": "pnpm test && pnpm test:db",
    "typecheck": "tsc --noEmit",
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "e2e": "playwright test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "library:audit": "tsx src/audit/cli.ts",
    "eval": "tsx src/eval/cli.ts",
    "eval:live": "node --env-file-if-exists=.env.local --import tsx src/eval/cli.ts --live",
    "eval:compare": "tsx src/eval/compare-cli.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "ai": "^7.0.157",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
